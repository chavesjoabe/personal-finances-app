# MongoDB Configuration
# For local Docker instance: mongodb://localhost:27017
# For MongoDB Atlas instance: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE=personal-finances

# JWT Authentication Secret Key (Must be at least 256 bits / 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_here_must_be_at_least_32_chars_long
JWT_EXPIRATION_HOURS=24

# CORS Origins (Comma-separated list of allowed origins or regex enclosed in /.../)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Port (optional, defaults to 8080)
PORT=8080
QUARKUS_HTTP_PORT=8080
